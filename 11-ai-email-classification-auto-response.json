      "parameters": {
        "inputText": "={{ $json.snippet }}",
        "categories": {
          "categories": [
            {
              "category": "Order",
              "description": "=Emails related to placing a new order, asking about an order, changing an order, or providing order details."
            },
            {
              "category": "Order Complete",
              "description": "=Emails confirming that an order has been completed, delivered, received, or successfully processed."
            },
            {
              "category": "Job",
              "description": "=Emails related to jobs, employment, hiring, interviews, recruitment, or job opportunities"
            },
            {
              "category": "Job Provider",
              "description": "=Emails from clients, companies, or recruiters offering a job, project, freelance work, or employment opportunity."
            },
            {
              "category": "Complaint",
              "description": "=Emails containing complaints about a product, service, delivery, employee, payment, or customer experience."
            },
            {
              "category": "Payment",
              "description": "=Emails related to payments, invoices, billing, transactions, payment confirmation, or payment problems."
            },
            {
              "category": "Refund",
              "description": "=Emails requesting, discussing, confirming, or following up about refunds, returns, or canceled orders."
            },
            {
              "category": "Customer Inquiry",
              "description": "=Emails where a customer asks questions about products, services, prices, availability, features, or general information."
            },
            {
              "category": "Technical Support",
              "description": "=Emails reporting technical problems, errors, bugs, login issues, software problems, or requesting technical assistance."
            },
            {
              "category": "Business Proposal",
              "description": "=Emails containing business offers, partnership proposals, collaboration opportunities, or potential business deals."
            },
            {
              "category": "Meeting",
              "description": "=Emails related to scheduling, confirming, rescheduling, or discussing meetings, calls, interviews, or appointments."
            },
            {
              "category": "Sales / Lead",
              "description": "=Emails from potential customers or leads showing interest in a product, service, quotation, purchase, or business service."
            },
            {
              "category": "Marketing / Promotion",
              "description": "=Promotional, advertising, newsletter, sales, marketing, or promotional campaign emails."
            },
            {
              "category": "Important / Urgent",
              "description": "=Emails requiring immediate attention, urgent action, deadlines, critical problems, or time-sensitive requests."
            },
            {
              "category": "General",
              "description": "=Emails that do not clearly belong to any other category and contain general information, communication, or miscellaneous requests."
            }
          ]
        },
        "options": {}
      },
